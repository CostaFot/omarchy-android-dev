#!/usr/bin/python3
# Entry point for the Android Dev helper. Everything lives in androiddev/
# next to this file; this shim only fixes sys.path so the plugin folder can
# be cloned anywhere (or symlinked in during development).
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from androiddev.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
